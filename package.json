{
  "name": "francais-catalan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Catalan grammar trainer for French speakers. Single-user static web app, Svelte 5 + Vite.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest --run",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen-schema": "tsx scripts/gen-schema.ts",
    "validate-ids": "tsx scripts/validate-ids.ts",
    "check-glosses": "tsx scripts/check-glosses.ts",
    "check-duplicates": "tsx scripts/check-duplicates.ts",
    "eval": "tsx scripts/eval.ts",
    "eval:record": "tsx scripts/eval-record.ts",
    "eval:sheet": "tsx scripts/eval-sheet.ts",
    "eval:verdicts": "tsx scripts/eval-verdicts.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "svelte": "^5.57.3",
    "ts-fsrs": "^4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@fontsource/literata": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.1",
    "ajv": "^8.17.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^3.23.1",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte-check": "^4.7.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  }
}
