{
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "printWidth": 88,
  "tabWidth": 2,
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.md", "docs/**/*.md"],
      "options": {
        "proseWrap": "preserve"
      }
    },
    {
      "files": "*.svelte",
      "options": {
        "parser": "svelte"
      }
    }
  ],
  "plugins": ["prettier-plugin-svelte"]
}
