{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "PowerShell(npm run:*)",
      "PowerShell(npm test:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.claude/settings.local.json)",
      "Read(./CLAUDE.local.md)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/guard-bash.mjs",
            "timeout": 10,
            "statusMessage": "Checking command against the project denylist"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/guard-read.mjs",
            "timeout": 10,
            "statusMessage": "Checking read target"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/format-edited.mjs",
            "timeout": 60,
            "statusMessage": "Formatting the edited file"
          },
          {
            "type": "command",
            "command": "node scripts/hooks/taxonomy-guard.mjs",
            "timeout": 120,
            "statusMessage": "Revalidating taxonomy invariants"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/stop-tests.mjs",
            "timeout": 300,
            "statusMessage": "Running the test suite"
          }
        ]
      }
    ]
  }
}
